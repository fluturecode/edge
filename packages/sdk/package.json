{
  "name": "@edge-protocol/sdk",
  "version": "0.9.9",
  "description": "Programmable trust infrastructure for autonomous AI agents on Sui. Give agents your rules, not your keys.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "require": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "DOCS.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' src/test.ts",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@mysten/sui": "^1.30.0",
    "@mysten/zklogin": "^0.8.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/react": "^18.3.31",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
